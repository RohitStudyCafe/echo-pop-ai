# ==============================================================================
# Echo Pop Cloud AI Voice Assistant - Environment Configuration
# ==============================================================================

# Default active provider ('openai' or 'gemini')
DEFAULT_PROVIDER=openai

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Latency and Timeout Optimization (Alexa timeout is ~8-10 seconds)
REQUEST_TIMEOUT_SECONDS=7.0
MAX_HISTORY_MESSAGES=8

# Alexa Skills Kit Request Signature Verification
# Set to 'false' for local development, tests, or initial staging
# Set to 'true' in production on your cloud VPS
VERIFY_ALEXA_SIGNATURE=false

# Optional Skill ID verification (e.g., amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
ALEXA_SKILL_ID=

# Persistence Configuration
# Keep 'false' until you run scripts/init_db.sql manually in your database
PERSISTENCE_ENABLED=false
DATABASE_URL=

